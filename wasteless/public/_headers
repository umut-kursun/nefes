/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

/sw.js
  Cache-Control: no-store
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

/version.json
  Cache-Control: no-store
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

/workbox-*.js
  Cache-Control: no-store
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

/worker-*.js
  Cache-Control: no-store
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store

/manifest.json
  Cache-Control: no-cache, no-store, must-revalidate

/manifest.webmanifest
  Cache-Control: no-cache, no-store, must-revalidate

/fallback-*.js
  Cache-Control: no-store
  CDN-Cache-Control: no-store
  Cloudflare-CDN-Cache-Control: no-store
