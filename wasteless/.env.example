# Server (required)
OPENAI_API_KEY=sk-...

# OpenAI vision / OCR model (optional — defaults apply when unset)
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_OCR_MODEL=gpt-4o-mini
OPENAI_VISION_FALLBACK_MODEL=gpt-4o

# Product knowledge admin (optional — settings admin UI)
KB_ADMIN_PASSWORD=

# --- Do NOT set in production unless you know why ---
# Force debug export UI and debug API routes (staging only)
# RECEIPT_ENGINE_DEBUG_EXPORT=1
# Save pipeline traces to disk (local dev only — not supported on Vercel)
# RECEIPT_ENGINE_DEBUG_SAVE=1
# OCR_DEBUG_SAVE=1

# Cloudflare static export (not used for Vercel)
# DEPLOY_TARGET=cloudflare
